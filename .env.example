# Supabase (deals + seen tables). Service-role key — keep secret, server-only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (deal alert emails). EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=
EMAIL_FROM=Ferie <alerts@yourdomain.no>
EMAIL_TO=ck@drivkapital.no

# Without Supabase vars the run falls back to an in-memory store (no cross-run
# dedup). Without Resend vars emails are printed to the log instead of sent.
