# Deal data lives in data/*.json in this repo — no database, nothing to configure.

# Resend (deal alert emails). EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=
EMAIL_FROM=Ferie <alerts@yourdomain.no>
EMAIL_TO=ck@drivkapital.no

# Without Resend vars emails are printed to the log instead of sent.
# Set FERIE_DATA_DIR=:memory: for a dry run that leaves data/ untouched.
