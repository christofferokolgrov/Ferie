# Deals are read from data/deals.json in the public repo, so no credentials are
# needed for the data itself. Override the source only for a fork or a private
# mirror (a private repo would need a token-authenticated URL instead):
# DEALS_URL=https://raw.githubusercontent.com/OWNER/REPO/main/data/deals.json

# For the "Run screening now" button. A GitHub token allowed to dispatch the
# sweep workflow. Use a fine-grained PAT scoped to the Ferie repo with
# "Actions: Read and write". Server-only — never exposed to the browser.
GH_DISPATCH_TOKEN=
# Optional overrides (defaults shown):
# GH_REPO=christofferokolgrov/Ferie
# GH_WORKFLOW=sweep.yml
# GH_REF=main
