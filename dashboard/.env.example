# Server-only. Same values as the GitHub Actions secrets. The service-role key
# is used exclusively in server components (never shipped to the browser), so
# the deals table stays locked (RLS) with no public access.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# For the "Run screening now" button. A GitHub token allowed to dispatch the
# sweep workflow. Use a fine-grained PAT scoped to the Ferie repo with
# "Actions: Read and write". Server-only — never exposed to the browser.
GH_DISPATCH_TOKEN=
# Optional overrides (defaults shown):
# GH_REPO=christofferokolgrov/Ferie
# GH_WORKFLOW=sweep.yml
# GH_REF=main
